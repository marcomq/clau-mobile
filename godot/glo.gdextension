[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
macos = "res://bin/macos/libglo_godot.dylib"
linux.x86_64 = "res://bin/linux/libglo_godot.so"
linux.arm64 = "res://bin/linux/libglo_godot.so"
windows.x86_64 = "res://bin/windows/glo_godot.dll"
android.arm64 = "res://bin/android/libglo_godot.so"
