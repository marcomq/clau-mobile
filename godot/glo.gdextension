[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
macos.debug = "res://bin/libglo_godot.dylib"
macos.release = "res://bin/libglo_godot.dylib"
android.debug.arm64 = "res://bin/libglo_godot.so"
android.release.arm64 = "res://bin/libglo_godot.so"
